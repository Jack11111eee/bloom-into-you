---
ns: home
heroFraming: {"fx":57,"fy":50}
---
{% from "ui/macros.njk" import icon, orb, bloomMark %}
<header class="hero" data-tone="light">
  <div class="hero__media" data-parallax="-3" data-parallax-mode="top">
    <img src="/assets/img/studio-01.jpg" alt="" width="5832" height="4008" fetchpriority="high" decoding="async" style="--focus-x: {{ heroFraming.fx }}%">
  </div>
  <div class="tanzaku" data-tanzaku data-intro="drop">
    <div class="tanzaku__swing">
      <span class="tanzaku__string" aria-hidden="true"></span>
      <span class="tanzaku__knot" aria-hidden="true"></span>
      <div class="tanzaku__paper">
        <p class="tanzaku__text"><span>A story </span><span>of becoming </span></p>
        {{ icon('star') }}
      </div>
    </div>
  </div>
  {% include "shell/header.njk" %}
  <div class="hero__lead" data-intro>
    <span class="hero__arrow" data-turn="0,90">{{ icon('arrow') }}</span>
    <p class="t-lead"><span>A feeling,</span> still unnamed</p>
  </div>
  <div class="hero__marquee" data-intro data-parallax="4" data-parallax-mode="top" data-parallax-axis="x">
    <h1 class="u-visually-hidden">Bloom Into You</h1>
    <div class="marquee" data-marquee aria-hidden="true">
      <div class="marquee__track"><span class="marquee__text">Bloom Into You</span><span class="marquee__sep">—</span></div>
    </div>
  </div>
</header>

<section class="intro section">
  <div class="wrap wrap--narrow intro__grid">
    <h2 class="intro__heading t-lead" data-reveal="words">{{ home.introHeading }}</h2>
    <div class="intro__aside">
      <p class="intro__text t-note" data-reveal="fade">{{ home.introText }}</p>
      <div class="intro__orb" data-parallax="2">{{ orb('/about', 'About this site') }}</div>
    </div>
  </div>
</section>

{%- for b in home.blocks %}
{% include "blocks/render.njk" %}
{%- endfor %}

<section class="featured section" data-cursor-zone>
  <div class="wrap">
    <p class="t-label featured__label">Characters</p>
    <ol class="index-list index-list--feature" role="list">
    {%- for item in homeFeatured %}
      <li class="index-row">
        <a href="{{ item.href }}" data-cursor="preview" data-cursor-index="{{ loop.index0 }}">
          <h3 class="index-row__title"><span>{{ item.name }}</span></h3>
          <p class="index-row__cell">{{ item.line }}</p>
        </a>
      </li>
    {%- endfor %}
    </ol>
  </div>
  {% set tiles = homeFeatured %}{% set tileStyle = 'feature' %}
  {% include "sections/tiles.njk" %}
</section>

<section class="chapters section">
  <div class="wrap">
    <p class="t-label chapters__label">Chapters</p>
    <ol class="chapter-list" role="list">
    {%- for chapter in site.chapters %}
      <li class="chapter-row">
        <a href="{{ chapter.href }}">
          <span class="chapter-row__index t-label">{{ '0' + loop.index }}</span>
          <h3 class="chapter-row__title">{{ chapter.name }}</h3>
          <p class="chapter-row__note t-note">{% if chapter.note %}{{ chapter.note }}{% endif %}</p>
          <span class="chapter-row__thumb" style="background-color: {{ chapter.tileColor }}" aria-hidden="true">
          {%- if chapter.tileThumb %}<img src="{{ chapter.tileThumb }}" alt="" loading="lazy" decoding="async">{% else %}{{ bloomMark() }}{% endif -%}
          </span>
        </a>
      </li>
    {%- endfor %}
    </ol>
  </div>
</section>
{% include "shell/page-end.njk" %}
