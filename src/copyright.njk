---
ns: copyright
---
{% set ending = 'plain' %}
<header class="page-head legal-head">
  {% include "shell/header.njk" %}
  <div class="page-head__body wrap wrap--narrow" data-intro><h1 class="page-head__title" id="copyright-page-title">{{ copyright.title }}</h1></div>
</header>
<section class="legal-page section">
   <div class="wrap wrap--narrow">
      <article class="copyright-reading" aria-labelledby="copyright-page-title">
         <p>{{ copyright.intro }}</p>
         <p>{{ copyright.affiliation }}</p>
         <h2>{{ copyright.ownershipTitle }}</h2>
         <p>{{ copyright.materials }}</p>
         <ul>
            <li><strong>{{ copyright.mangaLabel }}</strong> {{ copyright.mangaCredit }}</li>
            <li><strong>{{ copyright.animeLabel }}</strong> <span class="copyright-credit" lang="ja">{{ copyright.animeCredit }}</span></li>
            <li><strong>{{ copyright.publisherLabel }}</strong> {{ copyright.publisherCredit }}</li>
         </ul>
         <p>{{ copyright.permission }}</p>
         <h2>{{ copyright.rightsTitle }}</h2>
         <p>{{ copyright.respect }}</p>
         <p>{{ copyright.request }}</p>
         <p><strong>{{ copyright.emailLabel }}</strong> <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></p>
         <p>{{ copyright.response }}</p>
         <p>{{ copyright.corrections }}</p>
         <p>{{ copyright.thanks }}</p>
      </article>
   </div>
</section>
<section class="legal-page section legal-page--rights">
   <div class="wrap wrap--narrow">
      <article class="rights-reading" aria-labelledby="rights-handling-title">
         <h2 id="rights-handling-title">{{ rightsHandling.title }}</h2>
         {% for section in rightsHandling.sections %}
         <h3>{{ section.title }}</h3>
         {% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
         {% endfor %}
         <p class="content-license-reading"><span>{{ contentLicense.intro }}</span> <a class="license-identifier" href="{{ contentLicense.legalUrl }}" target="_blank" rel="noopener noreferrer" data-barba-prevent>{{ contentLicense.identifier }}</a> · <span>{{ contentLicense.exclusions }}</span> <a href="/assets/licenses/CONTENT-LICENSING.md" target="_blank" rel="noopener noreferrer" data-barba-prevent>{{ contentLicense.scopeLabel }}</a></p>
         <p><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a> · <a href="/privacy/">{{ privacy.title }}</a></p>
         <p class="image-sources-entry"><a href="/image-sources/">{{ imageSources.entryLabel }}</a></p>
      </article>
   </div>
</section>
{% include "shell/page-end.njk" %}
