---
ns: privacy
pagination:
  data: locales
  size: 1
  alias: language
permalink: "{% if language != 'en' %}/{{ language }}{% endif %}/privacy/index.html"
---
<header class="section default-header copyright-header" data-scroll-section="">
   {% include "partials/nav-bar.njk" %}
   <div class="container medium once-in">
      <div class="row"><div class="flex-col"><h1 id="privacy-page-title">{{ privacy.title }}</h1></div></div>
   </div>
</header>
<section class="section copyright-content" data-scroll-section="">
   <div class="container medium">
      <article class="privacy-reading" aria-labelledby="privacy-page-title">
         <p>{{ privacy.updated }}</p>
         <p>{{ privacy.intro }}</p>
         {% for section in privacy.sections %}
         <h2>{{ section.title }}</h2>
         {% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
         {% for link in section.links %}<p><a href="{{ link.href }}" target="_blank" rel="noopener noreferrer" data-barba-prevent>{{ link.label }}</a></p>{% endfor %}
         {% endfor %}
         <p>{{ privacy.contactLabel }} <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></p>
      </article>
   </div>
</section>
{% include "partials/footer-contact.njk" %}
