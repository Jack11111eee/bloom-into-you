---
ns: privacy
---
{% from "ui/macros.njk" import outLink %}
{% set documentTitle = privacy.title %}{% set documentId = 'privacy-page-title' %}
{% include "sections/document-head.njk" %}
<section class="legal-page section">
  <div class="wrap wrap--narrow"><article class="privacy-reading" aria-labelledby="privacy-page-title">
    {%- for opening in [privacy.updated, privacy.intro] %}
    <p>{{ opening }}</p>
    {%- endfor %}
    {%- for part in privacy.sections %}
    <h2>{{ part.title }}</h2>
    {%- for text in part.paragraphs %}<p>{{ text }}</p>{% endfor %}
    {%- for link in part.links %}<p>{{ outLink(link.href, link.label) }}</p>{% endfor %}
    {%- endfor %}
    <p>{{ privacy.contactLabel }} <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></p>
  </article></div>
</section>
{% include "shell/page-end.njk" %}
