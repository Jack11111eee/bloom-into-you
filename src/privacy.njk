---
ns: privacy
---
{% set ending = 'plain' %}
<header class="page-head legal-head">
  {% include "shell/header.njk" %}
  <div class="page-head__body wrap wrap--narrow" data-intro><h1 class="page-head__title" id="privacy-page-title">{{ privacy.title }}</h1></div>
</header>
<section class="legal-page section">
   <div class="wrap wrap--narrow">
      <article class="privacy-reading" aria-labelledby="privacy-page-title">
         <p>{{ privacy.updated }}</p>
         <p>{{ privacy.intro }}</p>
         {% for section in privacy.sections %}
         <h2>{{ section.title }}</h2>
         {% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
         {% for link in section.links %}<p><a href="{{ link.href }}" target="_blank" rel="noopener noreferrer" data-barba-prevent>{{ link.label }}</a></p>{% endfor %}
         {% endfor %}
         <p>{{ privacy.contactLabel }} <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></p>
      </article>
   </div>
</section>
{% include "shell/page-end.njk" %}
