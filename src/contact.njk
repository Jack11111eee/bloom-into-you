---
ns: contact
---
{% from "ui/macros.njk" import icon, pill, orb %}
{% set ending = 'plain' %}
{% set avatarStyle = site.avatarFraming | framingAttr('background') %}
<header class="page-head contact-head" data-tone="dark">
  {% include "shell/header.njk" %}
  <div class="wrap wrap--narrow contact-head__intro" data-intro>
    <div class="contact-head__lead">
      <h1 class="page-head__title t-title"><span><span class="avatar avatar--inline"{{ avatarStyle | safe }} aria-hidden="true"></span> A thought to share, </span></h1>
      <p class="t-note">A different reading, a small detail, or a question about an image — write to me at <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>.</p>
    </div>
    <div class="contact-head__portrait">
      <span class="avatar avatar--large"{{ avatarStyle | safe }} aria-hidden="true"></span>
      <span class="contact-head__arrow">{{ icon('arrow') }}</span>
    </div>
  </div>
  <div class="wrap wrap--narrow contact-head__body" data-intro>
    <div class="contact-head__form">
      <form class="form" action="mailto:{{ site.contact.email }}" method="get" data-mail-draft>
        {%- set fields = [
          ['form-name', 'name', 'text', 'What should I call you?', 'Your name *'],
          ['form-part', 'part', 'text', 'Which part stayed with you?', 'A character, a scene, or a small detail *'],
          ['form-topic', 'topic', 'text', 'What would you like to share?', 'A reading, a question, or an image credit *'],
          ['form-message', 'message', 'textarea', 'Leave me a few words', 'Take your time. What would you like to tell me? *']
        ] %}
        {%- for field in fields %}
        <div class="form__row">
          <span class="form__index t-label">{{ '0' + loop.index }}</span>
          <label class="form__label" for="{{ field[0] }}">{{ field[3] }}</label>
          {%- if field[2] == 'textarea' %}
          <textarea class="field" id="{{ field[0] }}" name="{{ field[1] }}" rows="6" placeholder="{{ field[4] }}" required></textarea>
          {%- else %}
          <input class="field" type="{{ field[2] }}" id="{{ field[0] }}" name="{{ field[1] }}" value="" placeholder="{{ field[4] }}" required>
          {%- endif %}
        </div>
        {%- endfor %}
        <div class="form__send">{{ orb(null, 'Open email draft', { submit: true, accent: true }) }}</div>
      </form>
      <p class="t-small t-note">Sending opens your own email app with these words in place. Nothing is sent until you send it there.</p>
      <p class="t-small t-note">This page does not store or send anything itself.</p>
      {{ pill('mailto:' + site.contact.email, 'Write by email', { inverse: true, magnet: 25 }) }}
    </div>
    <aside class="contact-head__details">
      <p class="t-label">Contact Details</p>
      <ul role="list" class="contact-head__list">
        <li><a class="text-link" href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></li>
      </ul>
      <p class="t-label">Site Details</p>
      <ul role="list" class="contact-head__list t-note">
        <li>Bloom Into You</li>
        <li>A personal reading site</li>
        <li>Complete manga · Volumes 1–8</li>
        <li>Images, characters, and close readings</li>
      </ul>
    </aside>
  </div>
</header>
{% include "shell/page-end.njk" %}
