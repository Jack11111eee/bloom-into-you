{#- Character and insight indexes: the table on wide screens, the cards on narrow ones. -#}
<header class="page-head">
  {% include "shell/header.njk" %}
  <div class="page-head__body wrap wrap--narrow" data-intro>
    <h1 class="page-head__title t-title"><span>{{ headingFirst }}</span><span>{{ headingLast }}</span></h1>
    <p class="page-head__note t-note">{{ headingNote }}</p>
  </div>
</header>
<section class="index-view">
  <div class="wrap index-view__panes" data-intro data-cursor-zone>
    <div class="index-table">
      <div class="index-table__head" aria-hidden="true">
      {%- for label in indexList.headers %}
        <p class="t-label">{{ label }}</p>
      {%- endfor %}
      </div>
      <ol class="index-list index-list--table" role="list">
      {%- for item in indexList.rows %}
        <li class="index-row">
          <a href="{{ item.href }}" data-cursor="preview" data-cursor-index="{{ loop.index0 }}">
            <h2 class="index-row__title"><span>{{ item.name }}</span></h2>
            <p class="index-row__cell">{{ item.col2 }}</p>
            <p class="index-row__cell">{{ item.col3 }}</p>
            <p class="index-row__cell">{{ item.col4 }}</p>
          </a>
        </li>
      {%- endfor %}
      </ol>
    </div>
    {% set tiles = indexList.rows %}{% set tileStyle = 'index' %}
    {% include "sections/tiles.njk" %}
  </div>
</section>
{% include "shell/page-end.njk" %}
