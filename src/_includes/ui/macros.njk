{#- Shared building blocks. Each macro owns one visual component. -#}

{% macro icon(name) -%}
{%- if name == 'arrow' -%}
<svg class="icon icon--arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 12.5 12.5 3.5M5.2 3.5h7.3v7.3"/></svg>
{%- elif name == 'rows' -%}
<svg class="icon icon--rows" viewBox="0 0 20 20" aria-hidden="true"><path d="M1 3.5h18M1 8h18M1 12.5h18M1 17h18"/></svg>
{%- elif name == 'grid' -%}
<svg class="icon icon--grid" viewBox="0 0 20 20" aria-hidden="true"><rect x="1.5" y="1.5" width="7" height="7" rx="1.5"/><rect x="11.5" y="1.5" width="7" height="7" rx="1.5"/><rect x="1.5" y="11.5" width="7" height="7" rx="1.5"/><rect x="11.5" y="11.5" width="7" height="7" rx="1.5"/></svg>
{%- elif name == 'globe' -%}
<svg class="language-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/></svg>
{%- elif name == 'star' -%}
<svg class="icon icon--star" viewBox="-12 -12 24 24" aria-hidden="true"><path d="M0-10 2.9-3.1 10-3.1 4.3 1.3 6.2 8.6 0 4.3-6.2 8.6-4.3 1.3-10-3.1-2.9-3.1Z"/></svg>
{%- endif -%}
{%- endmacro %}

{% macro bloomMark(extra = '') -%}
<svg class="bloom-mark {{ extra }}" viewBox="-12 -12 24 24" aria-hidden="true"><g class="bloom-mark__petals">
{%- for angle in [0, 72, 144, 216, 288] -%}
<g transform="rotate({{ angle }})"><ellipse rx="2.7" ry="5.2" cy="-5.6" style="--i: {{ loop.index0 }}"/></g>
{%- endfor -%}
</g><circle class="bloom-mark__core" r="1.8"/></svg>
{%- endmacro %}

{#- Pill: outlined capsule with a fill that rises on hover. -#}
{% macro pill(href, label, opts = {}) -%}
<a class="pill{{ ' pill--inverse' if opts.inverse }}{{ ' ' + opts.cls if opts.cls }}" href="{{ href }}" data-magnet="{{ opts.magnet or 28 }}" data-fill
{%- if opts.prevent %} data-barba-prevent{% endif %}>
  <span class="pill__fill" aria-hidden="true"></span>
  <span class="pill__label" data-magnet-inner>{{ label }}{% if opts.count %}<sup class="pill__count">{{ opts.count }}</sup>{% endif %}</span>
</a>
{%- endmacro %}

{#- Orb: the large round call to action. -#}
{% macro orb(href, label, opts = {}) -%}
{%- if opts.disabled -%}
<span class="orb orb--disabled{{ ' orb--accent' if opts.accent }}">
  <button class="orb__label" type="button" disabled>{{ label }}</button>
</span>
{%- else -%}
<a class="orb{{ ' orb--accent' if opts.accent }}" href="{{ href }}" data-magnet="{{ opts.magnet or 90 }}" data-fill>
  <span class="orb__fill" aria-hidden="true"></span>
  <span class="orb__label" data-magnet-inner>{{ label }}</span>
</a>
{%- endif -%}
{%- endmacro %}

{#- Responsive image. Thumbnails exist only for media that declares srcSmall. -#}
{% macro picture(media, sizes, opts = {}) -%}
<img class="{{ opts.cls or 'media-img' }}"
  {%- if media.srcSmall %} src="{{ media.srcSmall }}" srcset="{{ media.srcSmall }} 540w, {{ media.src }} {{ media.width }}w" sizes="{{ sizes }}"
  {%- else %} src="{{ media.src }}"{% endif %}
  {%- if media.width %} width="{{ media.width }}" height="{{ media.height }}"{% endif %} alt="{{ opts.alt or '' }}"
  {%- if opts.eager %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async"
  {{- media.framing | framingAttr('object') | safe }}>
{%- endmacro %}

{#- Link that leaves the site in a new tab and is never handled by the page router. -#}
{% macro outLink(href, label, cls = '') -%}
<a{% if cls %} class="{{ cls }}"{% endif %} href="{{ href }}" target="_blank" rel="noopener noreferrer" data-barba-prevent>{{ label }}</a>
{%- endmacro %}
