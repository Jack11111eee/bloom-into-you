{#
  partials/case-intro.njk — 案例页的 3 列元信息（SPEC.md §6.1）

  注意 `<li><p>…</p></li>` 的 `<li>` **直接挂在 `.flex-col` 下**（没有 `<ul>`）——
  原站如此，不是合法列表结构。照抄：结构 diff 逐元素比对，补一个 `<ul>` 会立刻报差异。
#}
<section class="section case-intro once-in" data-scroll-section>
   <div class="container medium">
      <div class="row">
{%- for col in project.intro %}
         <div class="flex-col">
            <h5>{{ col.label }}</h5>
            <div class="stripe"></div>
{%- for item in col.items %}
            <li><p>{{ item }}</p></li>
{%- endfor %}
         </div>
{%- endfor %}
      </div>
   </div>
</section>
