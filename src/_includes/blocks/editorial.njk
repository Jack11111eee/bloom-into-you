{#- Owner-designed editorial layouts. Crops are baked into the WebP variants. -#}
{% set sizesFor = {
  text: '(max-width: 540px) calc(100vw - 40px), (max-width: 1200px) 76vw, (min-width: 1900px) 710px, 38vw',
  detail: '(max-width: 540px) calc(100vw - 40px), (max-width: 1200px) 76vw, (min-width: 1900px) 820px, 44vw',
  portrait: '(max-width: 540px) calc(100vw - 40px), (max-width: 1200px) 512px, (min-width: 1900px) 574px, 31vw',
  sequence: '(max-width: 840px) calc(100vw - 40px), (max-width: 1200px) 26vw, (min-width: 1900px) 431px, 23vw',
  quiet: '(max-width: 840px) calc(100vw - 40px), (max-width: 1200px) 45vw, (min-width: 1900px) 750px, 40vw',
  pair: '(max-width: 840px) calc(100vw - 40px), (max-width: 1200px) 38vw, (min-width: 1900px) 646px, 34vw',
  lead: '(max-width: 840px) calc(100vw - 40px), (max-width: 1200px) 48vw, (min-width: 1900px) 808px, 43vw',
  follow: '(max-width: 840px) calc(100vw - 40px), (max-width: 1200px) 31vw, (min-width: 1900px) 517px, 28vw'
} %}
{#- Image variants come from replacementMedia, keyed by the block's slot name. -#}
{% macro figure(item, sizes) -%}
{%- set art = replacementMedia[item.slot] -%}
{%- set sources = [] -%}
{%- for variant in art.variants %}{% set sources = (sources.push(variant.src + ' ' + variant.width + 'w'), sources) %}{% endfor -%}
<figure class="editorial-figure" data-replacement-slot="{{ item.slot }}">
  <div class="editorial-image" style="aspect-ratio: {{ art.aspectRatio }};"><img src="{{ art.src }}" srcset="{{ sources | join(', ') }}" sizes="{{ sizes }}" width="{{ art.width }}" height="{{ art.height }}" alt="{{ item.alt }}" loading="lazy" decoding="async"></div>
  {%- if item.caption %}
  <figcaption>{{ item.caption }}</figcaption>
  {%- endif %}
</figure>
{%- endmacro %}
{% macro copy(paragraphs, extra = '') %}<div class="editorial-copy {{ extra }}">{% for p in paragraphs %}<p>{{ p }}</p>{% endfor %}</div>{% endmacro %}
{% set single = b.layout in ['detail', 'portrait', 'text'] %}
{% set ranked = b.layout in ['contrast', 'daily'] %}
<section class="block editorial editorial-{{ b.layout }} section block--pad-end" data-editorial-id="{{ b.id }}">
  <div class="wrap wrap--narrow">
  {%- if b.layout === 'steps' %}
    {%- for item in b.images %}
    <div class="editorial-row" data-reveal="fade">{{ figure(item, sizesFor.text) }}{{ copy(item.paragraphs) }}</div>
    {%- endfor %}
  {%- elif single %}
    <div class="editorial-row" data-reveal="fade">{{ figure(b.images[0], sizesFor[b.layout]) }}{{ copy(b.paragraphs) }}</div>
  {%- else %}
    <div data-reveal="fade">
      <div class="editorial-grid">
      {%- for item in b.images %}
        {%- if ranked %}{% set key = 'lead' if loop.first else 'follow' %}{% elif b.layout in ['sequence', 'quiet'] %}{% set key = b.layout %}{% else %}{% set key = 'pair' %}{% endif %}
        {{ figure(item, sizesFor[key]) }}
      {%- endfor %}
      </div>
      {%- if b.paragraphs %}{{ copy(b.paragraphs, 'editorial-after') }}{% endif %}
    </div>
  {%- endif %}
  </div>
</section>
