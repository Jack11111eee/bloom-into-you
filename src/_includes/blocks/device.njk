{#
  blocks/device.njk — `block-device`（SPEC.md §6.1，全站 31 个，最核心的块）

  两种媒体形态（§6.1）：
    · **video 形态**（多数）：`.device > .single-image > .overlay.overlay-image.playpauze > video.overlay`
    · **image/parallax 形态**（仅 andy-hardy block_0、one-nil block_3）：
      `.parallax-image-wrap > img.lazy[data-scroll-speed]` + 1–2 个 `img.overlay.overlay-image.overlay-top.lazy`

  设备外框（`.overlay-device-image`）**只在 `device !== 'nodevice'` 时存在**；
  外框图走内联 `background: url(...)`，不走 lazyload（§7.5）。
  `device-nodevice` 在本块内出现 **11** 次（`block-device` 的 31 个里最多），是**一等形态**而非例外。
  （全站 `device-*` 共 39 处、`nodevice` 13 处 —— 另外 2 处 `nodevice` 在 `block-mobile-devices` 里，
  见 `mobile-devices.njk`。`PLAN.md` P5 引用的 **13** 是这个全站口径，别与本块的 11 混起来。）
#}
<section class="section single-block block-device block_{{ b.index }}{{ ' block-padding-bottom' if b.paddingBottom }}"{% if b.background %} style="background-color: {{ b.background }};"{% endif %} data-scroll-section>
   <div class="container">
      <div class="row device-{{ b.device }}">
         <div class="flex-col">
            <div class="device">
               <div class="single-image">
{% if b.parallax %}
                  <div class="overlay overlay-image"><div class="parallax-image-wrap"><img class="lazy" src="{{ b.parallax.srcSmall }}" data-src="{{ b.parallax.src }}" width="{{ b.parallax.width }}" height="{{ b.parallax.height }}" data-scroll data-scroll-speed="{{ b.parallax.scrollSpeed }}"></div></div>
{%- for t in b.overlayTops %}
                  <img class="overlay overlay-image overlay-top lazy" src="{{ t.srcSmall }}" data-src="{{ t.src }}" width="{{ t.width }}" height="{{ t.height }}"{% if t.scrollSpeed %} data-scroll data-scroll-speed="{{ t.scrollSpeed }}"{% endif %}>
{%- endfor %}
{%- elif b.media.kind === 'video' %}
                  <div class="overlay overlay-image playpauze"><video class="overlay" src="{{ b.media.src }}" loop muted playsinline></video></div>
{%- else %}
{#- 取景（`DEVIATIONS.md` G1）。本分支的 img **不带** `data-scroll`（`data-scroll` 在 `.device` 上），
    但仍走 wrapper —— 与 fullwidth 同一套机制，避免"有的块这样、有的块那样"。#}
                  {{ b.media.framing | framingZoomOpen | safe }}<img class="overlay overlay-image lazy"{{ b.media.framing | framingAttr('object') | safe }} src="{{ b.media.srcSmall }}" data-src="{{ b.media.src }}" width="{{ b.media.width }}" height="{{ b.media.height }}">{{ b.media.framing | framingZoomClose | safe }}
{%- endif %}
               </div>
{% if b.frame %}
               <div class="overlay-device-image"><div class="overlay overlay-device" style="background: url('{{ b.frame }}') center center no-repeat; background-size: cover;"></div>{% if b.pencil %}<img class="{{ b.pencil.cls | join(' ') }}" data-scroll data-scroll-speed="{{ b.pencil.scrollSpeed }}" data-src="{{ b.pencil.src }}">{% endif %}</div>
{% endif %}
            </div>
         </div>
      </div>
   </div>
</section>
