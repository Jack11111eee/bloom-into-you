{#
  blocks/screenshot.njk — `block-screenshot`（SPEC.md §6.1，**全站仅 3 个**）

  结构最简：`.container > .row > .flex-col > .device > .single-image > <媒体>`
  媒体两种形态（§6.1）：
    · `<img class="lazy" …>` —— **不带** `overlay overlay-image` 类，与 device/fullwidth 不同
    · `<div class="playpauze"><video class="" …></video></div>` —— 仅 andy-hardy `block_5`
  分布：andy-hardy 2 个（`block_4` / `block_5`）、future-goals 1 个（`block_4`）。
#}
<section class="section single-block block-screenshot block_{{ b.index }}{{ ' block-padding-bottom' if b.paddingBottom }}"{% if b.background %} style="background-color: {{ b.background }};"{% endif %} data-scroll-section>
   <div class="container">
      <div class="row ">
         <div class="flex-col">
            <div class="device">
               <div class="single-image">
{% if b.media.kind === 'video' %}
                  <div class="playpauze"><video class="{{ b.media.cls | join(' ') }}" src="{{ b.media.src }}" loop muted playsinline></video></div>
{%- else %}
                  <img class="lazy" src="{{ b.media.srcSmall }}" data-src="{{ b.media.src }}" width="{{ b.media.width }}" height="{{ b.media.height }}">
{%- endif %}
               </div>
            </div>
         </div>
      </div>
   </div>
</section>
