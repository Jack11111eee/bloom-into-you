{#- The silent record collection: choose a song, the deck turns, its story opens beside it. -#}
<section class="music-section section">
  <div class="wrap wrap--narrow" id="bloom-vinyl-reader">
    <div class="record" role="region" aria-label="music.region" data-record>
      <div class="record__board" data-record-board>
        <div class="record__preview">
          <div class="record__deck" data-record-deck>
            <img class="record__poster" src="/assets/img/music/photo-wall.jpg" width="960" height="960" alt="music.art" decoding="async" fetchpriority="high">
            <div class="record__player" role="img" aria-label="music.deck" aria-hidden="true">
              <span class="record__brand">music.brand</span>
              <div class="record__platter"><div class="disc"><img class="disc__label" data-record-label src="{{ music.tracks[0].art }}" width="768" height="768" alt="" decoding="async"></div></div>
              <div class="record__arm"></div>
              <span class="record__lamp"></span>
            </div>
          </div>
          <div class="record__now" data-record-now hidden>
            <h2 class="record__now-title" data-record-name></h2>
            <p class="record__now-info" data-record-info></p>
            <button class="record__motion" type="button" data-record-motion>music.pause</button>
          </div>
        </div>
        <div class="record__side">
          <div class="record__list" data-record-list>
            <p class="record__list-head"><span>music.tracklist</span><span>music.count</span></p>
            <ul role="list">
            {%- for track in music.tracks %}
              <li class="record__item">
                <button class="record__song" type="button" data-song="{{ track.id }}" aria-expanded="false" aria-controls="record-reader">
                  <span class="disc" aria-hidden="true"><img class="disc__label" src="{{ track.art }}" alt="" width="768" height="768" decoding="async"></span>
                  <span><span class="record__song-name" lang="{{ 'ja' if track.id in ['one', 'three'] else 'en' }}">{{ track.title }}</span><span class="record__song-meta">{{ track.meta }}</span></span>
                  <span class="record__open">music.open</span>
                </button>
              </li>
            {%- endfor %}
            </ul>
          </div>
          <article class="record__reader" id="record-reader" aria-labelledby="record-reader-title" data-record-reader hidden>
            <div class="record__reader-head">
              <div><span class="record__position" data-record-position></span><h2 class="record__reader-title" id="record-reader-title"></h2></div>
              <button class="record__return" type="button" data-record-return>music.back</button>
            </div>
            <div class="record__pages" tabindex="0" role="region" aria-label="music.reader" data-record-pages data-lenis-prevent>
            {%- for track in music.tracks %}
              <div class="record__story" data-story="{{ track.id }}" hidden>{% for key in track.paragraphs %}<p>{{ key }}</p>{% endfor %}</div>
            {%- endfor %}
            </div>
            <p class="record__reader-foot"><span>music.story</span><span data-record-hint aria-hidden="true">music.down</span></p>
          </article>
        </div>
      </div>
      <p class="record__status" role="status" data-record-status>music.choose</p>
      <div class="record__phrases" hidden>
        {%- for phrase in ['choose', 'silent', 'pause', 'resume', 'reduced', 'down', 'end'] %}
        <span data-phrase="{{ phrase }}">music.{{ phrase }}</span>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>
