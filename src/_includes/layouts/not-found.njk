<!DOCTYPE html>
<html lang="{{ site.lang }}" data-locale="{{ locale }}" data-path="{{ canonical }}">
{% include "shell/head.njk" %}
{% import "shell/language.njk" as language with context %}
<body class="lost-page">
  <div id="not-found" class="lost">
    <header class="lost__bar">
      <a class="lost__brand" href="/" data-brand><span aria-hidden="true">· </span>Bloom Into You</a>
      {{ language.disclosure(canonical, locale) }}
      <nav class="lost__links" aria-label="Main navigation">
        <ul role="list">
          {%- for item in site.navBar %}{% if item.href %}
          <li><a href="{{ item.href }}">{{ item.label }}</a></li>
          {%- endif %}{% endfor %}
        </ul>
      </nav>
      <details class="lost__menu">
        <summary>Menu</summary>
        <div class="lost__menu-panel" data-tone="dark">
          <nav aria-label="Website navigation">
            {%- for item in site.navBar %}{% if item.href %}<a href="{{ item.href }}">{{ item.label }}</a>{% endif %}{% endfor %}
          </nav>
          {{ language.row(canonical, locale) }}
        </div>
      </details>
    </header>
    <main class="lost__main not-found-main">
{{ content | safe }}
    </main>
    <footer class="lost__footer">{% include "shell/legal.njk" %}</footer>
  </div>
</body>
</html>
