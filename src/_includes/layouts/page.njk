<!DOCTYPE html>
<html lang="{{ site.lang }}" data-locale="{{ locale }}" data-path="{{ canonical }}">
{% include "shell/head.njk" %}
<body data-barba="wrapper">
  <a class="skip-link" href="#{{ ns }}">Skip to content</a>
  {% include "shell/curtain.njk" %}
  <p class="u-visually-hidden" data-route-announcer aria-live="polite"></p>
  <main class="page page--{{ ns }}" id="{{ ns }}" tabindex="-1" data-barba="container" data-barba-namespace="{{ ns }}">
    {% include "shell/cursor.njk" %}
    {% include "shell/menu.njk" %}
    <div class="page__content">
{{ content | safe }}
    </div>
  </main>
  <script defer src="/assets/vendor/gsap-3.15.1.min.js"></script>
  <script defer src="/assets/vendor/ScrollTrigger-3.15.1.min.js"></script>
  <script defer src="/assets/vendor/lenis-1.3.27.min.js"></script>
  <script defer src="/assets/vendor/barba-core-2.10.3.js"></script>
  <script defer src="/assets/js/music.js"></script>
  <script type="module" src="/assets/js/app.js"></script>
</body>
</html>
