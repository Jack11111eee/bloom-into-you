---
ns: imageSources
---
{% from "ui/macros.njk" import outLink %}
{% set documentTitle = imageSources.title %}{% set documentId = 'image-sources-title' %}
{% include "sections/document-head.njk" %}
<section class="legal-page section">
  <div class="wrap wrap--narrow"><article class="privacy-reading image-sources-reading" aria-labelledby="image-sources-title">
    {%- for opening in ['updated', 'intro', 'limitations', 'coverage'] %}
    <p>{{ imageSources[opening] }}</p>
    {%- endfor %}
    <section class="original-music-sources" aria-labelledby="original-music-sources-title">
      <h2 id="original-music-sources-title">music.original.heading</h2>
      <p>music.original.notice</p>
      <ul class="image-source-list" role="list">
        {%- for art in imageSources.originalMusic %}
        <li class="original-music-entry" data-original-id="{{ art.id }}"><p>{{ art.label }}</p>{{ outLink(art.asset, 'music.original.view') }}</li>
        {%- endfor %}
      </ul>
    </section>
    {%- for group in imageSources.groups %}
    <h2>{{ group.heading }}</h2>
    <ul class="image-source-list" role="list">
      {%- for source in group.entries %}
      <li class="image-source-entry" data-source-id="{{ source.id }}">
        <p><span class="image-source-id">{{ source.id }}</span><br><span>{{ source.matching }}</span></p>
        <p>
          {{- outLink(source.asset, imageSources.imageLabel, 'site-image-link') }} · {{ outLink(source.sourcePage, imageSources.sourceLabel, 'source-page-link') }}
          {%- for extra in source.additionalPages %} · {{ outLink(extra, imageSources.alternativeLabel, 'source-page-link') }}{% endfor -%}
        </p>
      </li>
      {%- endfor %}
    </ul>
    {%- endfor %}
    <p><a href="/copyright/">{{ imageSources.backLabel }}</a></p>
  </article></div>
</section>
{% include "shell/page-end.njk" %}
