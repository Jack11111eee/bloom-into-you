{% set ending = 'next' %}
<header class="page-head entry-head">
  {% include "shell/header.njk" %}
  <div class="page-head__body wrap wrap--narrow" data-intro>
    <h1 class="page-head__title t-title-xl">{{ entry.name }}</h1>
  </div>
  <dl class="entry-meta wrap wrap--narrow" data-intro>
  {%- for column in entry.intro %}
    <div class="entry-meta__group">
      <dt class="t-label">{{ column.label }}</dt>
      {%- for value in column.items %}
      <dd class="t-note">{{ value }}</dd>
      {%- endfor %}
    </div>
  {%- endfor %}
  </dl>
  {%- if entry.introImage.image %}
  <div class="entry-hero wrap{{ ' entry-hero--pad' if entry.introImage.paddingBottom }}" data-intro>
    <div class="entry-hero__frame" data-reveal="media">
      <img class="entry-hero__image" src="{{ entry.introImage.image | thumb }}" srcset="{{ entry.introImage.image | thumb }} 540w, {{ entry.introImage.image }} 2400w" sizes="(max-width: 720px) 100vw, 88vw" alt="" fetchpriority="high" decoding="async" data-parallax="{{ entry.introImage.scrollSpeed }}"{{ entry.introImage.framing | framingAttr('object') | safe }}>
    </div>
  </div>
  {%- endif %}
</header>
{%- for b in entry.blocks %}
{% include "blocks/render.njk" %}
{%- endfor %}
{%- if related.length %}
{% from "ui/macros.njk" import pill %}
<nav class="related section" aria-labelledby="related-title">
  <div class="wrap wrap--narrow">
    <p class="t-label" id="related-title">{{ 'Related insights' if entry.kind == 'character' else 'Characters in this reading' }}</p>
    <span class="rule"></span>
    <ul class="related__list" role="list">
    {%- for item in related %}
      <li>{{ pill(item.href, item.name) }}</li>
    {%- endfor %}
    </ul>
  </div>
</nav>
{%- endif %}
{% include "shell/page-end.njk" %}
{%- if entry.customCss %}
<style>{{ entry.customCss | safe }}</style>
{%- endif %}
