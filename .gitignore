# Local research captures and screenshots. They may contain third-party
# material, so they never enter the repository or the published website.
reference/
baselines/
previews/

# Dependencies, logs and system files
node_modules/
.pnpm-store/
*.log
npm-debug.log*
.DS_Store

# Build output (local root build and the GitHub Pages project-path build)
dist/
dist-pages/
.astro/
.cache/

# Local process documents and authoring notes stay on disk only.
# Every Markdown file in the repository root is local except the published ones.
/docs/
/*.md
!/README.md
!/README.zh-CN.md
!/LICENSING.md
!/THIRD_PARTY_NOTICES.md
!/CLAUDE.md
!/AGENTS.md

# Track only scripts needed to build, deploy, or check the current website.
# Historical probes, generators and authoring tools remain available locally.
/scripts/*
!/scripts/build-pages.mjs
!/scripts/check-pages.mjs
!/scripts/check-i18n.mjs
!/scripts/check-about-essay.mjs
!/scripts/check-links.mjs
!/scripts/test-i18n-build.mjs
